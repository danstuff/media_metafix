# Subtitle codec to embed as, per container; others get a sidecar .srt.
SUBTITLE_CODECS = {
    ".mkv": "srt", ".mp4": "mov_text", ".m4v": "mov_text",
    ".mov": "mov_text", ".webm": "webvtt",
}


# Language tags meaning "unknown"; such subtitles count as present.
UNTAGGED = {"", "und"}
SUBTITLE_EXTENSIONS = (".srt", ".ass", ".ssa", ".vtt", ".sub")


# OpenSubtitles' codes: ISO 639-1, sometimes with a region ("pt-BR").
SUB_LANG_RE = re.compile(r"([a-z]{2})(?:-([a-z]{2}))?", re.IGNORECASE)


def subtitle_language(text):
    """argparse type: "PT-br" -> "pt-BR"; rejects other shapes."""
    match = SUB_LANG_RE.fullmatch(text.strip())
    if not match:
        raise argparse.ArgumentTypeError(
            f"{text!r} isn't an OpenSubtitles language code "
            f"(e.g. en, fr, pt-BR)"
        )
    base, region = match.groups()
    return base.lower() + (f"-{region.upper()}" if region else "")


def base_language(lang):
    """"pt-BR" -> "pt"."""
    return lang.split("-")[0].lower()


def language_codes(lang):
    """Every tag `lang` subtitles might carry: "pt-BR" -> ("pt-BR",
    "pt", "por")."""
    base = base_language(lang)
    return (lang, base, *LANGUAGE_CODES.get(base, ()))


def iso639_2(lang):
    base = base_language(lang)
    return LANGUAGE_CODES.get(base, (base,))[0]


def subtitle_streams(path):
    return [
        s for s in ffprobe_json(path).get("streams", [])
        if s.get("codec_type") == "subtitle"
    ]


def sidecar_subtitles(path):
    """Subtitle files named after `path`, e.g. "<stem>.srt" or
    "<stem>.en.srt"."""
    stem = glob.escape(path.stem)
    return sorted({
        sidecar
        for ext in SUBTITLE_EXTENSIONS
        for pattern in (f"{stem}{ext}", f"{stem}.*{ext}")
        for sidecar in path.parent.glob(pattern)
    })


def sidecar_language(sidecar, video):
    """"en" for "<stem>.en.srt"; "" for "<stem>.srt"."""
    return sidecar.name[len(video.stem):-len(sidecar.suffix)].lstrip(".")


def has_subtitles(path, lang):
    """True if `path` has `lang` or untagged subtitles, embedded or
    alongside. Untagged ones count, so nothing gets doubled up."""
    accepted = {code.lower() for code in language_codes(lang)} | UNTAGGED
    return any(
        sidecar_language(sidecar, path).lower() in accepted
        for sidecar in sidecar_subtitles(path)
    ) or any(
        (stream.get("tags", {}).get("language") or "").lower() in accepted
        for stream in subtitle_streams(path)
    )


def search_params(path, root):
    """OpenSubtitles search params from tags, else the path."""
    file = str(path.relative_to(root))
    tags = read_tags(path)
    fields = {
        k: tags.get(k) or v for k, v in guess_fields(file).items()
    }
    if kind_of(file) == "movie":
        return {"query": fields["title"], "year": fields["year"],
                "type": "movie"}
    return {
        "query": fields["show"], "season_number": fields["season"],
        "episode_number": fields["episode"], "type": "episode",
    }


def pick_subtitle(results):
    """file_id of the best result (hash match, then most downloaded)."""
    ranked = sorted(results, reverse=True, key=lambda r: (
        bool(r["attributes"].get("moviehash_match")),
        r["attributes"].get("download_count", 0),
    ))
    for result in ranked:
        files = result["attributes"].get("files") or []
        if files:
            return files[0]["file_id"]
    return None


def find_subtitle(client, path, root, lang):
    """file_id of the best `lang` subtitle for `path`, or None."""
    try:
        results = client.search(languages=lang, moviehash=oshash(path))
    except ValueError:
        results = []
    if not any(r["attributes"].get("moviehash_match") for r in results):
        results += client.search(languages=lang,
                                 **search_params(path, root))
    return pick_subtitle(results)


def embed_subtitle(path, srt_path, lang):
    """Mux `srt_path` into `path` as a `lang` subtitle stream."""
    index = len(subtitle_streams(path))
    codec = SUBTITLE_CODECS[path.suffix.lower()]
    remux(path, [
        "-map", "1", f"-c:s:{index}", codec,
        f"-metadata:s:s:{index}", f"language={iso639_2(lang)}",
    ], extra_inputs=[srt_path])


def save_subtitle(path, data, lang):
    """Embed `data` in `path`, or save it alongside if the container
    can't hold text subtitles. Returns where it went."""
    srt_path = path.with_name(f"{path.stem}.{lang}.srt")
    srt_path.write_bytes(data)
    if path.suffix.lower() not in SUBTITLE_CODECS:
        return srt_path
    try:
        embed_subtitle(path, srt_path, lang)
    finally:
        srt_path.unlink()
    return path


def subtitle_file(subtitles_dir, root, video, lang):
    """Where `scan` saves `video`'s subtitles."""
    rel_dir = video.parent.relative_to(root)
    return Path(subtitles_dir) / rel_dir / f"{video.stem}.{lang}.srt"


def download_subtitle(client, root, video, dest, lang):
    """Save `video`'s best `lang` subtitles to `dest`. Returns
    "downloaded", "present", "missing" or "error"."""
    try:
        if dest.exists() or has_subtitles(video, lang):
            return "present"
        file_id = find_subtitle(client, video, root, lang)
        if file_id is None:
            warn(f"No {lang} subtitles found for {video}")
            return "missing"
        data = client.download(file_id)
    except (HTTPError, URLError, OSError, RuntimeError, KeyError,
            ValueError) as exc:
        warn(f"Subtitle download failed for {video}: {exc}")
        return "error"
    dest.parent.mkdir(parents=True, exist_ok=True)
    dest.write_bytes(data)
    print(f"Subtitles: {dest}")
    return "downloaded"


def verified_language(client, lang):
    """`lang` as OpenSubtitles spells it. Exits if it's unsupported;
    if the list can't be fetched, `lang` is used unchecked."""
    try:
        known = client.languages()
    except (HTTPError, URLError, OSError, ValueError, KeyError) as exc:
        warn(f"Couldn't fetch OpenSubtitles' languages ({exc}); using "
             f"{lang!r} unchecked.")
        return lang
    if lang.lower() not in known:
        sys.exit(f"Error: OpenSubtitles has no {lang!r} subtitles. Codes: "
                 f"{', '.join(sorted(known.values()))}")
    return known[lang.lower()]


def subtitle_setup(args):
    """(client, language) for downloading subtitles, or None if
    there's no API key. Exits on an unsupported --sub-lang."""
    client = opensubtitles_client(args)
    if client is None:
        return None
    return client, verified_language(client, args.sub_lang)


def queue_subtitles(root, client, lang, subtitles_dir):
    """Download `lang` subtitles for every video lacking them."""
    counts = Counter(
        download_subtitle(
            client, root, video,
            subtitle_file(subtitles_dir, root, video, lang), lang,
        )
        for video in iter_videos(root)
    )
    print(
        f"\n{counts['downloaded']} subtitle file(s) downloaded, "
        f"{counts['present']} already present, {counts['missing']} not "
        f"found, {counts['error']} error(s)."
    )


def subtitle_target(srt, dest_dir):
    """(video, lang) for a queued "<stem>.<lang>.srt", or None."""
    stem, _, lang = srt.name[:-len(".srt")].rpartition(".")
    for video in filter(is_video, iter_files(dest_dir)):
        if video.stem == stem:
            return video, lang
    return None


def apply_subtitle(srt, video, lang, dry_run):
    """Embed `srt` in `video` unless it already has `lang` subtitles.
    Returns True if it did (or would)."""
    if has_subtitles(video, lang):
        print(f"Keeping existing {lang} subtitles: {video}")
        return False
    dest = video if dry_run else save_subtitle(video, srt.read_bytes(), lang)
    report("subtitle", dest, dry_run)
    return True


def apply_subtitles(root, subtitles_dir, dry_run):
    """Embed every queued subtitle file. Returns how many were."""
    added = 0
    for srt, dest_dir in iter_queued_files(subtitles_dir, root):
        target = subtitle_target(srt, dest_dir)
        if target is None:
            warn(f"No video for queued subtitles: {srt}")
            continue
        try:
            added += apply_subtitle(srt, *target, dry_run)
        except (OSError, RuntimeError) as exc:
            warn(f"Failed to add subtitles to {target[0]}: {exc}")
    return added


