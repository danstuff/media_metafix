def two_digits(value):
    return f"{value:02d}" if value is not None else "00"


def template_values(path, tags):
    """%placeholder values for `path` from its tags."""
    return {
        "%show": tags.get("show") or "",
        "%season": two_digits(tags.get("season")),
        "%episode": two_digits(tags.get("episode")),
        "%title": (tags.get("title") or "").strip() or path.stem,
        "%series": tags.get("series") or "",
        "%year": tags.get("year") or "",
    }


def rename_file(path, template, dry_run=False):
    """Rename `path` (and its sidecar subtitles) from its tags."""
    values = template_values(path, read_tags(path))
    new_path = rename_target(path, render_filename(template, path, values))
    if new_path is None:
        return
    for sidecar in list(sidecar_subtitles(path)):
        lang_suffix = sidecar.name[len(path.stem):]
        move(sidecar, path.with_name(new_path.stem + lang_suffix), dry_run)
    move(path, new_path, dry_run)


def run_rename(args):
    """Rename episodes/movies from their tags via their templates."""
    if not (args.episodes or args.movies):
        note("give --episodes and/or --movies -- nothing to do.")
        return
    root = Path(args.root)
    for path in iter_videos(root):
        kind = kind_of(path.relative_to(root))
        template = args.episodes if kind == "episode" else args.movies
        if template:
            rename_file(path, template, args.dry_run)


