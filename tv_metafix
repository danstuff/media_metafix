def run_apply(args):
    root = Path(args.root)
    verify_queue_root(args.queue, root)
    apply_queue(root, args.queue, write_tags, args.dry_run)
    added = apply_subtitles(root, args.subs_dir, args.dry_run)
    if added:
        print(f"{added} video(s) {outcome('subtitle', args.dry_run)}.")


