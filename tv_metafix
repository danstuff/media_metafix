        "--opensubtitles-api-key", default=env("TMF_OPENSUBTITLES_API_KEY"),
        help="OpenSubtitles API key (default: $TMF_OPENSUBTITLES_API_KEY)",
    )
    if not login:
        return
    subparser.add_argument(
        "--opensubtitles-username",
        default=env("TMF_OPENSUBTITLES_USERNAME"),
        help="Optional login (default: $TMF_OPENSUBTITLES_USERNAME)",
    )
    subparser.add_argument(
        "--opensubtitles-password",
        default=env("TMF_OPENSUBTITLES_PASSWORD"),
        help="Login password (default: $TMF_OPENSUBTITLES_PASSWORD)",
    )


