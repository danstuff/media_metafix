def convert_file(path, to_ext):
    """Remux `path` into `to_ext`, keeping streams and tags."""
    tags = read_tags(path)
    codec = SUBTITLE_CODECS.get(to_ext)
    args = ["-c:s", codec] if codec else ["-sn"]
    new_path = remux(path, args, new_suffix=to_ext)
    write_tags(new_path, tags)
    return new_path


def run_convert(args):
    """Remux every `from` file under root into `to`."""
    if not require_ffmpeg("convert"):
        return
    exts = convert_extensions(args)
    if exts is None:
        return
    from_ext, to_ext = exts
    process_each(
        with_extension(iter_videos(args.root), from_ext),
        lambda path: f"{path.name} -> {path.with_suffix(to_ext).name}",
        lambda path: convert_file(path, to_ext),
        "convert", "file", args.dry_run,
    )


