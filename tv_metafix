USER_AGENT = "tv-metafix v0.1"

VIDEO_EXTENSIONS = {
    ".mkv", ".mp4", ".m4v", ".mov", ".avi", ".wmv", ".webm", ".mpg",
    ".mpeg", ".ts",
}
# Containers without a "collection" tag.
ALBUM_EXTENSIONS = {".mp4", ".m4v", ".mov", ".avi"}

EPISODE_FIELDS = ("show", "season", "episode", "title")
MOVIE_FIELDS = ("series", "title", "year")
INT_FIELDS = {"season", "episode", "year"}

# Queue field -> container tag.
TAG_KEYS = {
    "show": "show", "season": "season_number", "episode": "episode_sort",
    "title": "title", "series": "collection", "year": "date",
}
ALBUM_TAG_KEYS = dict(TAG_KEYS, series="album")

DEFAULT_SUBTITLES_DIR = str(Path(DEFAULT_TMP_DIR) / "subtitles")


# ---------------------------------------------------------------------------
# Library layout
# ---------------------------------------------------------------------------

def is_video(path):
    return path.suffix.lower() in VIDEO_EXTENSIONS


def kind_of(rel_path):
    """"episode" for show/season/file, "movie" for series/file."""
    return "episode" if len(Path(rel_path).parts) == 3 else "movie"


def fields_for(kind):
    return EPISODE_FIELDS if kind == "episode" else MOVIE_FIELDS


def iter_videos(root):
    """Every non-ignored video at movie or episode depth."""
    root = Path(root)
    spec = load_mmfignore(root)
    for top in iter_kept(spec, root, iter_dirs(root)):
        yield from iter_kept(spec, root, filter(is_video, iter_files(top)))
        for season in iter_kept(spec, root, iter_dirs(top)):
            files = filter(is_video, iter_files(season))
            yield from iter_kept(spec, root, files)


# ---------------------------------------------------------------------------
# Name parsing
# ---------------------------------------------------------------------------

SEASON_DIR_RE = re.compile(
    r"^\s*(?:season|series|s)?[\s._-]*0*(\d{1,3})\s*$", re.IGNORECASE,
)
SPECIALS_DIR_RE = re.compile(r"^\s*specials?\s*$", re.IGNORECASE)
# "S01E03", "s1.e3", "1x03"
SEASON_EPISODE_RE = re.compile(
    r"\bs(\d{1,2})[\s._-]*e(\d{1,3})\b|\b(\d{1,2})x(\d{2,3})\b",
    re.IGNORECASE,
)
# "03 - Title", "E03 Title", "Episode 3" -- not 4-digit years.
EPISODE_PREFIX_RE = re.compile(
    r"^\s*(?:e|ep|episode)?[\s._-]*0*(\d{1,3})\b[\s._-]*", re.IGNORECASE,
)
MOVIE_YEAR_RE = re.compile(r"[\s._-]*[(\[]((?:18|19|20)\d{2})[)\]]\s*$")
SEPARATORS = " ._-"


def season_from_dir(name):
    """Season number from a folder like "Season 02" or "Specials"."""
    if SPECIALS_DIR_RE.match(name):
        return 0
    match = SEASON_DIR_RE.match(name)
    return int(match.group(1)) if match else None


def season_episode_from_name(stem):
    """(season, episode) from an "S01E03"/"1x03" token, or None."""
    match = SEASON_EPISODE_RE.search(stem)
    if not match:
        return None
    season, episode = match.group(1, 2) if match.group(1) else \
        match.group(3, 4)
    return int(season), int(episode)


def episode_from_name(stem):
    """Episode number from a filename stem, or None."""
    pair = season_episode_from_name(stem)
    if pair:
        return pair[1]
    match = EPISODE_PREFIX_RE.match(stem)
    return int(match.group(1)) if match else None


def strip_episode_number(stem):
    """"Show - S01E03 - Title" / "03 - Title" -> "Title"."""
    match = SEASON_EPISODE_RE.search(stem)
    if match:
        return stem[match.end():].strip(SEPARATORS)
    return EPISODE_PREFIX_RE.sub("", stem).strip(SEPARATORS)


def year_from_name(stem):
    match = MOVIE_YEAR_RE.search(stem)
    return int(match.group(1)) if match else None


def strip_year(stem):
    """"Title (2001)" -> "Title"."""
    return MOVIE_YEAR_RE.sub("", stem).strip()


def guess_fields(rel_path):
    """Fields implied by the folder structure and filename alone."""
    path = Path(rel_path)
    if kind_of(rel_path) == "movie":
        return {
            "series": path.parent.name,
            "title": strip_year(path.stem),
            "year": year_from_name(path.stem),
        }
    return {
        "show": path.parent.parent.name,
        "season": season_from_dir(path.parent.name),
        "episode": episode_from_name(path.stem),
        "title": strip_episode_number(path.stem) or None,
    }


# ---------------------------------------------------------------------------
# Tag I/O via ffprobe/ffmpeg
# ---------------------------------------------------------------------------

def tag_keys(path):
    return ALBUM_TAG_KEYS if path.suffix.lower() in ALBUM_EXTENSIONS \
        else TAG_KEYS


def read_tags(path):
    """{queue field: value} from `path`'s container tags."""
    raw = ffprobe_json(path).get("format", {}).get("tags", {})
    raw = {k.lower(): v for k, v in raw.items()}
    # ffmpeg writes AVI "album" as IPRD but reads it back as "product".
    raw.setdefault("album", raw.get("product"))
    tags = {}
    for field, key in tag_keys(path).items():
        value = raw.get(key)
        if field in INT_FIELDS:
            value = leading_int(value)
        tags[field] = value
    return tags


def metadata_args(path, fields):
    args = []
    for field, key in tag_keys(path).items():
        if fields.get(field) is not None:
            args += ["-metadata", f"{key}={fields[field]}"]
    return args


def remux(path, extra_args, new_suffix=None, extra_inputs=()):
    """Copy `path`'s streams through ffmpeg with `extra_args`,
    replacing it. Returns the final path."""
    tmp_out = temp_output_path(path, new_suffix)
    cmd = ["ffmpeg", "-y", "-loglevel", "error", "-i", str(path)]
    for extra in extra_inputs:
        cmd += ["-i", str(extra)]
    cmd += ["-map", "0", "-map_metadata", "0", "-c", "copy"]
    cmd += extra_args + [str(tmp_out)]
    run_ffmpeg(cmd, tmp_out)
    return replace_with(path, tmp_out, new_suffix)


def unsaved_fields(path, fields):
    """Fields whose value didn't survive being written to `path`."""
    tags = read_tags(path)
    return [
        k for k, v in fields.items()
        if v is not None and str(tags.get(k)) != str(v).strip()
    ]


def write_tags(path, fields):
    args = metadata_args(path, fields)
    if not args:
        return
    remux(path, args)
    unsaved = unsaved_fields(path, fields)
    if unsaved:
        warn(f"{path.suffix} can't store {', '.join(unsaved)} for {path} "
             f"-- try `convert` to .mkv.")


# ---------------------------------------------------------------------------
# Lookups: TVmaze (episodes) and TMDB (movies)
# ---------------------------------------------------------------------------

TVMAZE_SEARCH_URL = "https://api.tvmaze.com/singlesearch/shows"
TMDB_SEARCH_URL = "https://api.themoviedb.org/3/search/movie"


def tvmaze_episodes(show):
    """(TVmaze's show name, {(season, episode): title}), or None."""
    try:
        data = fetch_json(
            TVMAZE_SEARCH_URL, {"q": show, "embed": "episodes"},
            {"User-Agent": USER_AGENT},
        )
    except HTTPError as exc:
        if exc.code == 404:
            return None
        raise
    episodes = data.get("_embedded", {}).get("episodes", [])
    titles = {
        (ep["season"], ep["number"]): ep["name"]
        for ep in episodes if ep.get("number") is not None
    }
    return data.get("name"), titles


def tmdb_movie(title, year, api_key):
    """{"title", "year"} of TMDB's best match, or None."""
    params = {"query": title, "api_key": api_key}
    if year:
        params["year"] = year
    results = fetch_json(TMDB_SEARCH_URL, params).get("results") or []
    if not results:
        return None
    best = results[0]
    return {
        "title": best.get("title"),
        "year": leading_int((best.get("release_date") or "")[:4]),
    }


def show_episodes(show, args, cache):
    """{(season, episode): title} for `show`, or None."""
    if args.no_tvmaze:
        return None
    result = cached(
        cache, ("tvmaze", show), lambda: tvmaze_episodes(show),
        f"TVmaze lookup for {show!r}",
    )
    if result is None:
        return None
    name, titles = result
    if fuzzy_ratio(name, show) < FUZZY_SAME_ENOUGH:
        warn(f"TVmaze matched {name!r} for folder {show!r}.")
    return titles


def match_episode(guess, titles):
    """(season, episode, title) from `titles` for a guessed episode,
    by number or else fuzzy title, or None."""
    season = guess["season"]
    key = (season, guess["episode"])
    if key in titles:
        return (*key, titles[key])
    if not guess["title"]:
        return None
    in_season = {k: t for k, t in titles.items() if k[0] == season}
    best = best_fuzzy_match(in_season, guess["title"])
    return (*best, titles[best]) if best else None


def match_movie(guess, args, cache):
    """TMDB's {"title", "year"} for a guessed movie, or None."""
    if not args.tmdb_api_key:
        return None
    title, year = guess["title"], guess["year"]
    return cached(
        cache, ("tmdb", title, year),
        lambda: tmdb_movie(title, year, args.tmdb_api_key),
        f"TMDB lookup for {title!r}",
    )


# ---------------------------------------------------------------------------
# scan
# ---------------------------------------------------------------------------

def differs(field, new, current):
    if new is None:
        return False
    if field in INT_FIELDS:
        return new != current
    return should_replace(str(new), current)


def queue_differences(updates, current, found):
    """Add each `found` field that differs from `current`."""
    for field, value in found.items():
        if differs(field, value, current.get(field)):
            updates[field] = value


def episode_updates(path, guess, current, args, cache):
    updates = {}
    queue_differences(updates, current, {
        "show": guess["show"], "season": guess["season"],
    })
    titles = show_episodes(guess["show"], args, cache)
    match = match_episode(guess, titles) if titles else None
    if match:
        _season, episode, title = match
        found = {"episode": episode, "title": title}
    else:
        warn(f"No TVmaze match found for {path}")
        found = {"episode": guess["episode"]}
    queue_differences(updates, current, found)
    return updates


def movie_updates(path, guess, current, args, cache):
    updates = {}
    queue_differences(updates, current, {"series": guess["series"]})
    match = match_movie(guess, args, cache)
    if not match:
        warn(f"No TMDB match found for {path}, using its filename.")
    queue_differences(updates, current, match or guess)
    return updates


def compute_scan_change(root, path, args, cache):
    """None, or (file, fields, previous) for `path`'s queue entry."""
    file = str(path.relative_to(root))
    kind = kind_of(file)
    guess = guess_fields(file)
    current = read_tags(path)
    compute = episode_updates if kind == "episode" else movie_updates
    updates = compute(path, guess, current, args, cache)
    if not updates:
        return None
    fields, previous = build_queue_fields(current, updates, fields_for(kind))
    return file, fields, previous


def run_scan(args):
    """Queue changes for every video, and download subtitles unless
    --no-subs."""
    if not require_ffmpeg("read tags"):
        return
    if not args.tmdb_api_key:
        note("no TMDB API key -- movie titles come from filenames.")
    # Checked first, so a bad --sub-lang fails before the slow part.
    subtitles = None if args.no_subs else subtitle_setup(args)
    root = Path(args.root)
    cache = {}
    counts = scan_to_queue(
        args, iter_videos(root),
        lambda path: compute_scan_change(root, path, args, cache),
        "Video",
    )
    if subtitles:
        queue_subtitles(root, *subtitles, args.subs_dir)
    print_scan_summary(counts, args)


# ---------------------------------------------------------------------------
# OpenSubtitles: file hashes and subtitles
# ---------------------------------------------------------------------------

OPENSUBTITLES_URL = "https://api.opensubtitles.com/api/v1"
OSHASH_CHUNK = 64 * 1024


def oshash(path):
    """OpenSubtitles' file hash: size plus the 64-bit sums of the first
    and last 64 KiB."""
    size = path.stat().st_size
    if size < OSHASH_CHUNK * 2:
        raise ValueError("file too small to hash")
    total = size
    with open(path, "rb") as f:
        for offset in (0, size - OSHASH_CHUNK):
            f.seek(offset)
            words = struct.unpack("<8192Q", f.read(OSHASH_CHUNK))
            total += sum(words)
    return f"{total & 0xFFFFFFFFFFFFFFFF:016x}"


class OpenSubtitles:
    def __init__(self, api_key, token=None):
        self.api_key = api_key
        self.token = token

    def headers(self):
        headers = {"Api-Key": self.api_key, "User-Agent": USER_AGENT}
        if self.token:
            headers["Authorization"] = f"Bearer {self.token}"
        return headers

    def call(self, endpoint, params=None, body=None):
        return fetch_json(
            f"{OPENSUBTITLES_URL}/{endpoint}", params, self.headers(), body,
        )

    def login(self, username, password):
        self.token = self.call(
            "login", body={"username": username, "password": password},
        )["token"]

    def languages(self):
        """{lowercased code: code} of every subtitle language."""
        data = self.call("infos/languages").get("data", [])
        return {d["language_code"].lower(): d["language_code"] for d in data}

    def search(self, **params):
        return self.call("subtitles", {
            k: v for k, v in params.items() if v is not None
        }).get("data", [])

    def download(self, file_id):
        link = self.call("download", body={"file_id": file_id})["link"]
        return fetch(link, headers={"User-Agent": USER_AGENT})


def opensubtitles_client(args):
    """An OpenSubtitles client, logged in if credentials are set, or
    None if there's no API key."""
    if not args.opensubtitles_api_key:
        note(
            "no OpenSubtitles API key (--opensubtitles-api-key or "
            "$TMF_OPENSUBTITLES_API_KEY)."
        )
        return None
    client = OpenSubtitles(args.opensubtitles_api_key)
    username = getattr(args, "opensubtitles_username", None)
    if username:
        client.login(username, args.opensubtitles_password)
    return client


# ---------------------------------------------------------------------------
# fingerprint
# ---------------------------------------------------------------------------

FINGERPRINT_TITLE_THRESHOLD = 0.5   # deliberately low: a sanity check


def hash_matches(client, path):
    """feature_details of every subtitle matched by `path`'s hash."""
    results = client.search(moviehash=oshash(path))
    return [
        r["attributes"]["feature_details"] for r in results
        if r["attributes"].get("moviehash_match")
    ]


def feature_agrees(feature, fields):
    """True if OpenSubtitles' `feature` fits the queued `fields`."""
    if fields.get("episode") is not None:
        if (feature.get("season_number"), feature.get("episode_number")) \
                != (fields.get("season"), fields.get("episode")):
            return False
    title = fields.get("title")
    return not title or fuzzy_ratio(
        feature.get("title"), str(title),
    ) >= FINGERPRINT_TITLE_THRESHOLD


def describe_feature(feature):
    if feature.get("episode_number") is not None:
        return (
            f"S{feature.get('season_number')}E"
            f"{feature.get('episode_number')} {feature.get('title')!r}"
        )
    return f"{feature.get('title')!r} ({feature.get('year')})"


def fingerprint_one_file(client, root, file, fields):
    """"skipped", "unknown", "ok" or "mismatch" for one entry."""
    path = root / file
    if not path.exists():
        warn_missing_file(path)
        return "skipped"
    try:
        features = hash_matches(client, path)
    except (HTTPError, URLError, OSError, ValueError, KeyError) as exc:
        warn(f"Hash lookup failed for {file}: {exc}")
        return "skipped"
    if not features:
        return "unknown"
    if any(feature_agrees(f, fields) for f in features):
        return "ok"
    warn(f"{file}: queued entry doesn't match its file hash "
         f"(OpenSubtitles says {describe_feature(features[0])}).")
    return "mismatch"


def run_fingerprint(args):
    """Warn about queue entries OpenSubtitles' hash lookup disagrees
    with. Only exact, known releases can be identified."""
    client = opensubtitles_client(args)
    if client is None:
        return
    root = Path(args.root)
    counts = Counter(
        fingerprint_one_file(client, root, file, fields)
        for file, fields in load_queue(args.queue).items()
    )
    print(
        f"\n{counts['ok'] + counts['mismatch']} file(s) identified, "
        f"{counts['mismatch']} mismatch(es), {counts['unknown']} "
        f"unknown, {counts['skipped']} skipped."
    )


