EPISODE = ("episode", "episode number")
YEAR = ("year", "year")


def check_episode_group(lines, stats, season_dir, group):
    chk.check_partial_numbers(lines, stats, season_dir, group, *EPISODE)
    chk.check_number_gaps(lines, stats, season_dir, group, *EPISODE)
    chk.check_duplicate_titles(lines, stats, season_dir, group)
    chk.check_duplicates(
        lines, stats, season_dir, group, *EPISODE, leading_int,
    )
    for key in ("show", "season"):
        chk.check_inconsistent(lines, stats, season_dir, group, key)


def check_movie_group(lines, stats, series_dir, group):
    chk.check_duplicate_titles(lines, stats, series_dir, group)
    chk.check_inconsistent(lines, stats, series_dir, group, "series")


def check_group(lines, stats, group_dir, group):
    if kind_of(group[0][0]) == "episode":
        check_episode_group(lines, stats, group_dir, group)
    else:
        check_movie_group(lines, stats, group_dir, group)


def check_filename_season(lines, stats, file, fields):
    """Warn if an "S01E03"-style filename names another season."""
    pair = season_episode_from_name(Path(file).stem)
    season = fields.get("season")
    if not pair or season is None or pair[0] == season:
        return
    message = (
        f"{file}: filename says season {pair[0]}, but season is "
        f"{season}."
    )
    chk.warn_field(lines, stats, message, file, "season")


def check_year_plausible(lines, stats, file, fields):
    year = fields.get("year")
    if not isinstance(year, int) or 1870 <= year <= date.today().year + 2:
        return
    message = f"{file}: year {year} looks wrong."
    chk.warn_field(lines, stats, message, file, "year")


def check_episode(lines, stats, file, fields, group):
    chk.check_null_and_blank_fields(lines, stats, file, fields)
    for key in ("season", "episode"):
        chk.check_is_int(lines, stats, file, fields, key, key)
    chk.check_in_range(lines, stats, file, fields, group, *EPISODE)
    chk.check_nonzero(lines, stats, file, fields, *EPISODE)
    chk.check_filename_match(
        lines, stats, file, fields, *EPISODE,
        episode_from_name, strip_episode_number,
    )
    chk.check_title_number_prefix(
        lines, stats, file, fields, "episode", episode_from_name,
    )
    chk.check_title_matches_field(lines, stats, file, fields, "show")
    check_filename_season(lines, stats, file, fields)


def check_movie(lines, stats, file, fields, group):
    chk.check_null_and_blank_fields(lines, stats, file, fields)
    chk.check_is_int(lines, stats, file, fields, *YEAR)
    check_year_plausible(lines, stats, file, fields)
    chk.check_filename_match(
        lines, stats, file, fields, *YEAR, year_from_name, strip_year,
    )


def check_entry(lines, stats, file, fields, group):
    check = check_episode if kind_of(file) == "episode" else check_movie
    check(lines, stats, file, fields, group)


def run_check(args):
    """Flag likely mistakes in the queue, asking how to resolve each.
    No network, no root needed."""
    chk.run_check(args.queue, check_group, check_entry)


