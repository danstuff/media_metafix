# ---------------------------------------------------------------------------
# Tag I/O. mutagen's "easy" interface covers most formats; WAV needs raw
# ID3 frames.
# ---------------------------------------------------------------------------

WAV_FRAMES = {"album": TALB, "artist": TPE1, "title": TIT2,
              "tracknumber": TRCK}


def load_track(path):
    """An opaque tag handle for `path`, or None if unreadable."""
    if path.suffix.lower() == ".wav":
        return ("wav", mutagen.File(str(path)))
    audio = mutagen.File(str(path), easy=True)
    return ("easy", audio) if audio is not None else None


def frame_text(tags, frame_id):
    """First text value of an ID3 frame, or None."""
    if tags is None or frame_id not in tags:
        return None
    return tags[frame_id].text[0]


def get_tags_wav(audio):
    tags = audio.tags
    fields = {
        key: frame_text(tags, frame.__name__)
        for key, frame in WAV_FRAMES.items()
    }
    artists = tags.getall("TXXX:ARTISTS") if tags is not None else []
    fields["artists"] = [str(v) for v in artists[0].text] if artists else []
    return fields


def get_tags_easy(audio):
    def first(key):
        # ASF (wma) values are ASFUnicodeAttribute objects, not str.
        values = audio.get(key)
        return str(values[0]) if values else None

    fields = {key: first(key) for key in QUEUE_FIELDS}
    fields["artists"] = [str(v) for v in audio.get("artists") or []]
    return fields


def get_tags(handle):
    kind, audio = handle
    return get_tags_wav(audio) if kind == "wav" else get_tags_easy(audio)


def set_tags_wav(audio, updates):
    if audio.tags is None:
        audio.add_tags()
    for key, value in updates.items():
        if key == "artists":
            audio.tags.delall("TXXX:ARTISTS")
            audio.tags.add(TXXX(encoding=3, desc="ARTISTS",
                                text=list(value)))
        else:
            audio.tags.add(WAV_FRAMES[key](encoding=3, text=str(value)))


def set_tags_easy(audio, updates):
    for key, value in updates.items():
        audio[key] = list(value) if key == "artists" else str(value)


def set_tags(handle, updates):
    kind, audio = handle
    if kind == "wav":
        set_tags_wav(audio, updates)
    else:
        set_tags_easy(audio, updates)
    audio.save()


def read_track_tags(path):
    handle = load_track(path)
    if handle is None:
        raise RuntimeError("could not read tags")
    return get_tags(handle)


# ---------------------------------------------------------------------------
# Filenames
# ---------------------------------------------------------------------------

# "Track 3", "track03", "01 - Song", "3 Song" -- but not 3+ digit runs
# like "400 Lux" or "1999"; albums rarely pass 99 tracks.
FILENAME_TRACK_RE = re.compile(
    r"^\s*(?:track[\s_.-]*)?0*(\d{1,2})\b", re.IGNORECASE,
)
# The same prefix plus its separator: "01 - Song" -> "Song".
FILENAME_TRACK_PREFIX_RE = re.compile(
    r"^\s*(?:track[\s_.-]*)?0*\d{1,2}\b[\s_.-]*", re.IGNORECASE,
)

normalize_track = leading_int


def track_number_from_filename(stem):
    match = FILENAME_TRACK_RE.match(stem)
    return int(match.group(1)) if match else None


def strip_filename_track_prefix(stem):
    return FILENAME_TRACK_PREFIX_RE.sub("", stem)


def render_filename(template, path, tags):
    """`template` filled from `tags`, e.g. "%num - %title" ->
    "01 - Song.mp3". Periods are dropped from the title ("Mr. Jones"
    -> "Mr Jones")."""
    track_no = normalize_track(tags.get("tracknumber"))
    artists = tags.get("artists") or []
    title = (tags.get("title") or "").replace(".", "").strip()
    return render_template(template, path, {
        "%num": f"{track_no:02d}" if track_no is not None else "00",
        "%title": title or path.stem,
        "%artist": tags.get("artist") or "",
        # artists[0] is the main artist; the rest are featured.
        "%features": ", ".join(artists[1:]),
        "%album": tags.get("album") or "",
    })


# ---------------------------------------------------------------------------
# Root walking
# ---------------------------------------------------------------------------

def iter_albums(root, spec):
    """(artist, album, album_dir) for every non-ignored album."""
    for artist_dir in iter_kept(spec, root, iter_dirs(root)):
        for album_dir in iter_kept(spec, root, iter_dirs(artist_dir)):
            yield artist_dir.name, album_dir.name, album_dir


def is_audio(path):
    return path.suffix.lower() in AUDIO_EXTENSIONS


def iter_music_files(root):
    """Every non-ignored audio file under root."""
    root = Path(root)
    spec = load_mmfignore(root)
    for _artist, _album, album_dir in iter_albums(root, spec):
        files = filter(is_audio, iter_files(album_dir))
        yield from iter_kept(spec, root, files)


# ---------------------------------------------------------------------------
# Multi-disc albums: sibling "Album (Disc 1)", "Album (Disc 2)", ...
# folders are one album, "Album". Filenames number tracks per disc; the
# queue numbers them across the whole album.
# ---------------------------------------------------------------------------

DISC_FOLDER_RE = re.compile(r"^(.+?)\s*\(disc\s*(\d+)\)\s*$", re.IGNORECASE)


def parse_disc_folder(name):
    """("Album", 2) for "Album (Disc 2)", else None."""
    match = DISC_FOLDER_RE.match(name)
    return (match.group(1), int(match.group(2))) if match else None


def sibling_discs(album_dir):
    """{disc number: dir} for album_dir and its sibling discs, or {}
    unless album_dir is one disc of several."""
    parsed = parse_disc_folder(album_dir.name)
    if parsed is None:
        return {}
    discs = {}
    for sibling in iter_dirs(album_dir.parent):
        other = parse_disc_folder(sibling.name)
        if other and other[0].casefold() == parsed[0].casefold():
            discs[other[1]] = sibling
    return discs if len(discs) > 1 else {}


def album_identity(album_dir):
    """(album name, track offset) for album_dir. A disc of a
    multi-disc album is named for the whole album, and its tracks come
    after every audio file on the earlier discs."""
    discs = sibling_discs(album_dir)
    if not discs:
        return album_dir.name, 0
    album_name, disc = parse_disc_folder(album_dir.name)
    offset = sum(
        count_audio_files(disc_dir)
        for number, disc_dir in discs.items() if number < disc
    )
    return album_name, offset


def count_audio_files(album_dir):
    return sum(1 for f in iter_files(album_dir) if is_audio(f))


def album_track_count(album_dir):
    """Audio files in album_dir's whole album, every disc included."""
    discs = sibling_discs(album_dir) or {1: album_dir}
    return sum(count_audio_files(d) for d in discs.values())


def album_group_key(file):
    """The album a queued `file` belongs to, merging disc folders."""
    album_dir = Path(file).parent
    parsed = parse_disc_folder(album_dir.name)
    return album_dir.parent / parsed[0] if parsed else album_dir


def is_later_disc(file):
    """True for files in "(Disc N)" folders with N > 1."""
    parsed = parse_disc_folder(Path(file).parent.name)
    return bool(parsed) and parsed[1] > 1


# ---------------------------------------------------------------------------
# MusicBrainz
# ---------------------------------------------------------------------------

def configure_musicbrainz(contact):
    """Set musicbrainzngs's user-agent; False if it isn't installed."""
    if not musicbrainzngs:
        return False
    musicbrainzngs.set_useragent("music-metafix", "0.0", contact)
    return True


RELEASE_SEARCH_LIMIT = 25


def release_matches(release, artist_name, album_name):
    """True if a search result's title and credit roughly match the
    folder names."""
    return (
        fuzzy_ratio(release.get("title"), album_name)
        >= FUZZY_MATCH_THRESHOLD
        and fuzzy_ratio(release.get("artist-credit-phrase"), artist_name)
        >= FUZZY_MATCH_THRESHOLD
    )


def release_track_count(release):
    return sum(
        int(medium.get("track-count") or 0)
        for medium in release.get("medium-list") or []
    )


def release_rank(release, track_count):
    """Sort key putting the likeliest release for a folder of
    `track_count` files (if known) first: closest track count, then
    albums over singles, then official over bootleg or promo."""
    group = release.get("release-group") or {}
    return (
        abs(release_track_count(release) - track_count)
        if track_count else 0,
        group.get("primary-type") != "Album",
        release.get("status") != "Official",
    )


def find_release_id(artist_name, album_name, track_count=None):
    """The best release matching the folder names, or None. A strict
    (exact phrase) search goes first: loose searches OR every word, so
    "Pearl Jam" by Pearl Jam ranks "Jam Jam" by anyone first. Either
    way, results must roughly match the folder names. Exact matches
    often tie (an album and its single share a title), so they're
    ranked by release_rank."""
    for strict in (True, False):
        results = musicbrainzngs.search_releases(
            artist=artist_name, release=album_name,
            limit=RELEASE_SEARCH_LIMIT, strict=strict,
        )
        candidates = [
            release for release in results.get("release-list") or []
            if release_matches(release, artist_name, album_name)
        ]
        if candidates:
            best = min(candidates,
                       key=lambda r: release_rank(r, track_count))
            return best["id"]
    return None


def credited_artists(recording):
    credit = recording.get("artist-credit") or []
    return [
        c["artist"]["name"] for c in credit
        if isinstance(c, dict) and "artist" in c
    ]


def recognize_via_musicbrainz_text(artist_name, album_name,
                                   track_count=None):
    """{position: {"title", "artists"}} for an album, or None.
    Positions restart on each medium (disc, vinyl side), so each is
    offset by the earlier media's track counts: with 5 tracks on side
    A, B2 is position 7."""
    release_id = find_release_id(artist_name, album_name, track_count)
    if not release_id:
        return None
    full = musicbrainzngs.get_release_by_id(
        release_id, includes=["recordings", "artist-credits"],
    )
    track_map = {}
    offset = 0
    for medium in full["release"].get("medium-list", []):
        tracks = medium.get("track-list", [])
        for track in tracks:
            recording = track["recording"]
            track_map[offset + int(track["position"])] = {
                "title": recording["title"],
                "artists": credited_artists(recording),
            }
        offset += len(tracks)
    return track_map or None


def album_tracks(artist_name, album_name, args, cache, track_count=None):
    """MusicBrainz's track map for an album (cached), or None."""
    if not musicbrainzngs or args.no_musicbrainz:
        return None
    return cached(
        cache, (artist_name, album_name),
        lambda: recognize_via_musicbrainz_text(
            artist_name, album_name, track_count,
        ),
        f"MusicBrainz search for {artist_name}/{album_name}",
    )


def locate_track(track_map, filename_track, filename_title):
    """A file's position in `track_map`: its filename's track number
    if listed, else the closest title, else None."""
    if filename_track in track_map:
        return filename_track
    if not filename_title:
        return None
    titles = {pos: data["title"] for pos, data in track_map.items()}
    return best_fuzzy_match(titles, filename_title)


# ---------------------------------------------------------------------------
# Album art: `scan` downloads it to tmp/art; `apply` copies it into root.
# ---------------------------------------------------------------------------

ALBUM_ART_FILENAME = "art.jpg"
ALBUM_ART_SIZE = (300, 300)
COVER_ART_ARCHIVE_FRONT_URL = (
    "https://coverartarchive.org/release/{mbid}/front"
)


def fetch_cover_art(release_id):
    request = Request(
        COVER_ART_ARCHIVE_FRONT_URL.format(mbid=release_id),
        headers={"User-Agent": "music-metafix/0.0"},
    )
    with urlopen(request, timeout=20) as response:
        return response.read()


def image_format(filename):
    """Pillow's format for saving `filename` ("cover.png" -> "PNG"),
    or None if it can't write that extension."""
    fmt = Image.registered_extensions().get(Path(filename).suffix.lower())
    return fmt if fmt in Image.SAVE else None


def art_filename(text):
    """argparse type: a plain filename Pillow can save, e.g.
    cover.png."""
    name = text.strip()
    if not name or Path(name).name != name:
        raise argparse.ArgumentTypeError(
            f"{text!r} isn't a plain filename (e.g. cover.jpg)")
    suffix = Path(name).suffix
    if not suffix:
        raise argparse.ArgumentTypeError(
            f"{text!r} has no image extension (e.g. cover.jpg)")
    if Image is not None and image_format(name) is None:
        raise argparse.ArgumentTypeError(
            f"can't save {suffix!r} images; try .jpg or .png")
    return name


def save_album_art(image_bytes, dest_path):
    """Resize the art and save it in the format its name implies."""
    image = Image.open(io.BytesIO(image_bytes)).convert("RGB")
    image = image.resize(ALBUM_ART_SIZE, Image.LANCZOS)
    image.save(dest_path, image_format(dest_path.name))


def download_album_art(artist_name, album_name, dest_dir, filename,
                       track_count=None):
    """Save an album's cover art as dest_dir/filename. Errors are
    warned about, never raised."""
    dest_dir.mkdir(parents=True, exist_ok=True)
    art_path = dest_dir / filename
    album_key = f"{artist_name}/{album_name}"
    try:
        release_id = find_release_id(artist_name, album_name, track_count)
    except Exception as exc:
        warn(f"MusicBrainz release search failed for {album_key}: {exc}")
        return
    if not release_id:
        warn(f"No MusicBrainz release found for album art: {album_key}")
        return
    try:
        save_album_art(fetch_cover_art(release_id), art_path)
    except (URLError, OSError) as exc:
        if isinstance(exc, HTTPError) and exc.code == 404:
            warn(f"No cover art available for {album_key}")
        else:
            warn(f"Cover art download failed for {album_key}: {exc}")
        return
    print(f"Album art: {art_path}")


def album_art_available(contact):
    """True if album art can be downloaded; notes why not otherwise."""
    if not configure_musicbrainz(contact):
        missing_package(
            "musicbrainzngs", "musicbrainzngs", "can't download album art.",
        )
        return False
    if Image is None:
        missing_package("Pillow", "pillow", "can't download album art.")
        return False
    return True


def queue_album_art(root, art_dir, filename, contact):
    """Download cover art to art_dir/artist/album for every album
    without a `filename` of its own."""
    if not album_art_available(contact):
        return
    root = Path(root)
    spec = load_mmfignore(root)
    for artist_name, folder_name, album_dir in iter_albums(root, spec):
        if (album_dir / filename).exists():
            continue
        album_name, _offset = album_identity(album_dir)
        dest_dir = Path(art_dir) / artist_name / folder_name
        download_album_art(artist_name, album_name, dest_dir, filename,
                           album_track_count(album_dir))


def apply_album_art(root, art_dir, dry_run=False):
    """Copy queued art into matching albums, never replacing existing
    art. Returns the number of files copied."""
    copied = 0
    for art, dest_dir in iter_queued_files(art_dir, root):
        dest = dest_dir / art.name
        if dest.exists():
            print(f"Keeping existing album art: {dest}")
            continue
        if not dry_run:
            shutil.copyfile(art, dest)
        report("copy", dest, dry_run)
        copied += 1
    return copied


# ---------------------------------------------------------------------------
# scan
# ---------------------------------------------------------------------------

def apply_track_match(updates, current, pos, match):
    """Queue MusicBrainz's title/number/artists where they differ."""
    if should_replace(match["title"], current.get("title")):
        updates["title"] = match["title"]
    if normalize_track(current.get("tracknumber")) != pos:
        updates["tracknumber"] = str(pos)
    if match["artists"] and match["artists"] != current.get("artists"):
        updates["artists"] = match["artists"]


def queue_folder_names(updates, current, artist_name, album_name):
    """Queue the folder-trusted artist/album where tags differ."""
    if (current.get("artist") or "").strip() != artist_name:
        updates["artist"] = artist_name
    if (current.get("album") or "").strip() != album_name:
        updates["album"] = album_name


def queue_fallback_artists(updates, current, artist_name):
    """Without other credits, artists is just the folder's artist."""
    if "artists" not in updates and not current.get("artists"):
        updates["artists"] = [artist_name]


def queue_filename_track(updates, current, filename_track):
    """Last resort: the track number from the filename."""
    if "tracknumber" not in updates and filename_track is not None \
            and normalize_track(current.get("tracknumber")) != filename_track:
        updates["tracknumber"] = str(filename_track)


def coerce_queue_field(key, value):
    """Store a plain tracknumber as an int (keep "3/12" as-is)."""
    if key == "tracknumber" and "/" not in str(value):
        return int(value)
    return value


def compute_scan_change(root, path, args, cache):
    """None, or (file, fields, previous) for `path`'s queue entry.
    Files MusicBrainz can't match are queued with their existing tags
    (missing ones null) for check to flag."""
    current = read_track_tags(path)
    artist_name = path.parent.parent.name
    if path.parent not in cache:
        cache[path.parent] = (
            *album_identity(path.parent), album_track_count(path.parent),
        )
    album_name, track_offset, track_count = cache[path.parent]
    filename_track = track_number_from_filename(path.stem)
    if filename_track is not None:
        filename_track += track_offset
    filename_title = strip_filename_track_prefix(path.stem).strip()

    updates = {}
    queue_folder_names(updates, current, artist_name, album_name)
    track_map = album_tracks(
        artist_name, album_name, args, cache, track_count,
    ) or {}
    pos = locate_track(track_map, filename_track, filename_title)
    if pos is None:
        warn(f"No MusicBrainz match found for {path} -- queuing its "
             f"existing tags.")
    else:
        apply_track_match(updates, current, pos, track_map[pos])
    queue_filename_track(updates, current, filename_track)
    queue_fallback_artists(updates, current, artist_name)
    # Unmatched files are always queued, so check flags their nulls.
    if not updates and pos is not None:
        return None
    fields, previous = build_queue_fields(
        current, updates, QUEUE_FIELDS, coerce_queue_field,
    )
    return str(path.relative_to(root)), fields, previous


def run_scan(args):
    """Queue changes for every file, plus album art unless --no-art."""
    if not configure_musicbrainz(args.musicbrainz_contact):
        missing_package("musicbrainzngs", "musicbrainzngs",
                        "text-search recognition disabled.")
    root = Path(args.root)
    cache = {}
    counts = scan_to_queue(
        args, iter_music_files(root),
        lambda path: compute_scan_change(root, path, args, cache),
        "Music",
    )
    if not args.no_art:
        queue_album_art(root, args.art_dir, args.art_fn,
                        args.musicbrainz_contact)
    print_scan_summary(counts, args)


# ---------------------------------------------------------------------------
# fingerprint
# ---------------------------------------------------------------------------

MIN_ACOUSTID_SCORE = 0.6            # AcoustID's own confidence, 0-1
FINGERPRINT_TITLE_THRESHOLD = 0.5   # deliberately low: a sanity check

# Title variations stripped before comparing, so "Reckoner (Live)" or
# "Umbrella feat. Jay-Z - Radio Edit" match "Reckoner"/"Umbrella".
BRACKETED_ASIDE_RE = re.compile(r"\s*[\(\[][^)\]]*[\)\]]\s*$")
FEATURE_CREDIT_RE = re.compile(
    r"\s*[-–—]?\s*\b(?:feat\.?|ft\.?|featuring)\s+.+$",
    re.IGNORECASE,
)
# A trailing " - ..." clause is a version tag if any word is one of
# these, e.g. "Remastered 2011", "Acoustic Version", "Mono Mix".
VERSION_TAG_WORDS = {
    "live", "acoustic", "remaster", "remastered", "edit", "mix", "remix",
    "version", "mono", "stereo", "demo", "instrumental", "explicit",
    "clean", "deluxe", "bonus", "single", "album", "radio", "extended",
    "original", "session", "alternate", "reprise", "outtake", "take",
    "unplugged", "rehearsal",
}
VERSION_TAG_RE = re.compile(r"\s+[-–—]\s+([^-–—]+)$")


def strip_bracketed_aside(text):
    """"Song (Live)" -> "Song"."""
    return BRACKETED_ASIDE_RE.sub("", text).strip()


def strip_feature_credit(text):
    """"Song feat. X" -> "Song"."""
    return FEATURE_CREDIT_RE.sub("", text).strip()


def strip_version_tag(text):
    """"Song - Remastered 2011" -> "Song"."""
    match = VERSION_TAG_RE.search(text)
    if not match:
        return text
    words = set(re.findall(r"[a-z]+", match.group(1).lower()))
    if not words & VERSION_TAG_WORDS:
        return text
    return text[:match.start()].strip()


# Brackets go first, and every change restarts from the top, so a tag
# nested in brackets ("Song (feat. X) (Live)") goes with its bracket.
TITLE_STRIPPERS = (
    strip_bracketed_aside, strip_version_tag, strip_feature_credit,
)


def strip_title_variations(title):
    """Apply TITLE_STRIPPERS until none change anything, never
    emptying the title."""
    text = title.strip()
    changed = True
    while changed:
        changed = False
        for strip in TITLE_STRIPPERS:
            candidate = strip(text)
            if candidate and candidate != text:
                text, changed = candidate, True
                break
    return text


# AcoustID error codes caused by one file (missing parameter, invalid
# fingerprint, invalid duration), not the key or the service.
PER_FILE_ACOUSTID_ERRORS = {2, 3, 8}


def track_duration(path, fingerprint_duration):
    """`path`'s length in seconds. audioread's ffmpeg backend reports 0
    when ffmpeg can't tell ("Duration: N/A"), which AcoustID rejects as
    missing, so mutagen's reading is the fallback."""
    if fingerprint_duration >= 1:
        return fingerprint_duration
    try:
        handle = load_track(Path(path))
    except mutagen.MutagenError:
        return 0
    info = getattr(handle[1], "info", None) if handle else None
    return getattr(info, "length", 0) or 0


def acoustid_recording_titles(path, api_key):
    """Titles AcoustID offers for `path` with enough confidence."""
    duration, fp = acoustid.fingerprint_file(str(path))
    duration = track_duration(path, duration)
    if duration < 1:
        raise acoustid.AcoustidError("couldn't determine its duration")
    response = acoustid.lookup(api_key, fp, duration, meta=["recordings"])
    if response.get("status") != "ok":
        error = response.get("error", {})
        message = error.get("message", "unknown error")
        if error.get("code") in PER_FILE_ACOUSTID_ERRORS:
            raise acoustid.AcoustidError(message)
        raise acoustid.WebServiceError(message)
    return [
        recording["title"]
        for result in response.get("results", [])
        if result.get("score", 0) >= MIN_ACOUSTID_SCORE
        for recording in result.get("recordings", [])
        if recording.get("title")
    ]


def check_fingerprint_title(path, api_key, queued_title):
    """(ok, best_title, best_score); ok is None if AcoustID had no
    titles, else whether the best is a rough match."""
    titles = acoustid_recording_titles(path, api_key)
    if not titles:
        return None, None, 0.0
    target = strip_title_variations(queued_title)
    scores = {
        title: fuzzy_ratio(strip_title_variations(title), target)
        for title in titles
    }
    best_title = max(scores, key=scores.get)
    best_score = scores[best_title]
    return best_score >= FINGERPRINT_TITLE_THRESHOLD, best_title, best_score


class AbortFingerprinting(Exception):
    """An AcoustID failure that affects every remaining file."""


def lookup_fingerprint(path, api_key, title):
    """check_fingerprint_title, or None if this file's lookup failed.
    Raises AbortFingerprinting for failures affecting every file."""
    try:
        return check_fingerprint_title(path, api_key, title)
    except acoustid.NoBackendError:
        raise AbortFingerprinting(
            "fpcalc/chromaprint not found -- install libchromaprint-tools."
        )
    except acoustid.WebServiceError as exc:
        raise AbortFingerprinting(f"AcoustID web service error: {exc}")
    except acoustid.AcoustidError as exc:
        warn(f"AcoustID lookup failed for {path.name}: {exc}")
        return None


def fingerprint_one_file(root, api_key, lines, file, fields):
    """Counter keys for one entry: ("skipped",), ("checked",) or
    ("checked", "mismatch"[, "corrected"]). A mismatched title is
    replaced in `lines` with the closest fingerprint title, minus
    variations like "(Live)"."""
    title = fields.get("title")
    path = root / file
    if not title:
        return ("skipped",)
    if not path.exists():
        warn_missing_file(path)
        return ("skipped",)
    result = lookup_fingerprint(path, api_key, str(title))
    if result is None:
        return ("skipped",)
    ok, best_title, best_score = result
    if ok is None:
        warn(f"{file}: no AcoustID fingerprint match found for this file.")
    elif not ok:
        message = (
            f"{file}: queued title {title!r} doesn't match fingerprint "
            f"(closest: {best_title!r}, similarity {best_score:.2f})"
        )
        new_title = strip_title_variations(best_title)
        if chk.replace_field_value(
            lines, file, "title", render_yaml_scalar(new_title),
        ):
            warn(f"{message} -- corrected to {new_title!r}.")
            return ("checked", "mismatch", "corrected")
        warn(f"{message} -- couldn't find its title line to correct.")
        return ("checked", "mismatch")
    return ("checked",)


def fingerprinting_available(args):
    """True if pyacoustid and an API key are present."""
    if not acoustid:
        missing_package("pyacoustid", "pyacoustid", "can't fingerprint.")
        return False
    if not args.acoustid_api_key:
        note("no AcoustID API key set (--acoustid-api-key or "
             "$MMF_ACOUSTID_API_KEY) -- can't fingerprint.")
        return False
    return True


def run_fingerprint(args):
    """Correct queued titles that don't match what AcoustID hears,
    saving the queue after each correction."""
    if not fingerprinting_available(args):
        return
    root = Path(args.root)
    with open(args.queue, encoding="utf-8") as f:
        lines = f.read().splitlines()
    albums = chk.group_entries(load_queue(args.queue), album_group_key)
    counts = Counter()
    try:
        for i, (album, group) in enumerate(albums.items(), 1):
            print(f"[{i}/{len(albums)}] Fingerprinting {album.as_posix()} "
                  f"({len(group)} track(s))...")
            for file, fields in group:
                keys = fingerprint_one_file(
                    root, args.acoustid_api_key, lines, file, fields,
                )
                counts.update(keys)
                if "corrected" in keys:
                    chk.write_queue_lines(args.queue, lines)
    except AbortFingerprinting as exc:
        warn(f"{exc} Aborting fingerprint check.")
        return
    print(
        f"\n{counts['checked']} track(s) fingerprinted, "
        f"{counts['mismatch']} mismatch(es), {counts['corrected']} "
        f"corrected, {counts['skipped']} skipped."
    )


