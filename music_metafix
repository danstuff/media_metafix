def reencode(path, filter_arg=None, new_suffix=None):
    """Re-encode `path` in place, or as `new_suffix`, keeping its tags.
    Returns the final path."""
    tags = read_track_tags(path)
    tmp_out = temp_output_path(path, new_suffix)
    cmd = ["ffmpeg", "-y", "-loglevel", "error", "-i", str(path),
           "-map_metadata", "0"]
    if filter_arg:
        cmd += ["-af", filter_arg]
    run_ffmpeg(cmd + [str(tmp_out)], tmp_out)
    final_path = replace_with(path, tmp_out, new_suffix)
    out_handle = load_track(final_path)
    if out_handle is not None:
        set_tags(out_handle, {k: v for k, v in tags.items() if v})
    return final_path


def run_normalize(args):
    """Normalize every track's loudness with ffmpeg's loudnorm."""
    if not require_ffmpeg("normalize loudness"):
        return
    filter_arg = f"loudnorm=I={args.lufs}:TP=-1.5:LRA=11"
    process_each(
        iter_music_files(args.root), str,
        lambda path: reencode(path, filter_arg=filter_arg),
        "normalize", "track", args.dry_run,
    )


def run_convert(args):
    """Re-encode every `from` file under root as `to`."""
    if not require_ffmpeg("convert"):
        return
    exts = convert_extensions(args)
    if exts is None:
        return
    from_ext, to_ext = exts
    if from_ext not in AUDIO_EXTENSIONS:
        warn(f"{from_ext} isn't a recognized audio extension.")
    process_each(
        with_extension(iter_music_files(args.root), from_ext),
        lambda path: f"{path.name} -> {path.with_suffix(to_ext).name}",
        lambda path: reencode(path, new_suffix=to_ext),
        "convert", "track", args.dry_run,
    )


