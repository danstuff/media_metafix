def run_rename(root, template, dry_run=False):
    """Rename every file under root from its tags via `template`."""
    for path in iter_music_files(root):
        handle = load_track(path)
        if handle is None:
            warn(f"Could not read tags, skipping: {path}")
            continue
        new_name = render_filename(template, path, get_tags(handle))
        new_path = rename_target(path, new_name)
        if new_path:
            move(path, new_path, dry_run)


def run_rename_step(args):
    run_rename(args.root, args.template, args.dry_run)


