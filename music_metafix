# "artists" needs registering for mp3/m4a; other formats take any key.
EasyID3.RegisterTXXXKey("artists", "ARTISTS")
EasyMP4Tags.RegisterFreeformKey("artists", "ARTISTS")

QUEUE_FIELDS = ("album", "artist", "artists", "title", "tracknumber")
AUDIO_EXTENSIONS = {
    ".mp3", ".flac", ".ogg", ".oga", ".opus", ".m4a", ".aac", ".wma", ".wav",
}
