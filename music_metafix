def queue_fields_to_tag_updates(fields):
    """Queue `fields` as set_tags updates, skipping nulls."""
    updates = {}
    for key in QUEUE_FIELDS:
        value = fields.get(key)
        if value is None:
            continue
        if key == "artists":
            updates[key] = [str(v) for v in value]
        else:
            updates[key] = str(value).strip()
    return updates


def write_track_fields(path, fields):
    updates = queue_fields_to_tag_updates(fields)
    if not updates:
        return
    handle = load_track(path)
    if handle is None:
        raise RuntimeError("could not read tags")
    set_tags(handle, updates)


def run_apply(args):
    root = Path(args.root)
    verify_queue_root(args.queue, root)
    apply_queue(root, args.queue, write_track_fields, args.dry_run)
    art_copied = apply_album_art(root, args.art_dir, args.dry_run)
    if art_copied:
        print(f"{art_copied} album art file(s) "
              f"{outcome('copy', args.dry_run)}.")


